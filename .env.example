# Lab defaults. Copy to .env and adjust. Never put production secrets in git.

K6_VERSION=v2.2.0
PYTHON_VERSION=3.12.8

# Data
ORCHESTRATOR_CONFIG=/project/orchestrator.yml
DATA_DIR=./data

# Target resource limits (local lab only — not production-representative)
TARGET_APP_CPUS=1.0
TARGET_APP_MEMORY=1G
TARGET_DB_CPUS=0.5
TARGET_DB_MEMORY=512M

# Postgres lab
POSTGRES_USER=perf
POSTGRES_PASSWORD=perf
POSTGRES_DB=perf

# Influx / Grafana (lab tokens — replace in production)
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=adminadmin
INFLUXDB_ORG=perf
INFLUXDB_BUCKET=k6
INFLUXDB_TOKEN=lab-influx-token-not-for-production
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# SSH scan target for known_hosts bootstrap (lab demo default)
TARGET_SSH_HOST=target-app
TARGET_SSH_PORT=22
KNOWN_HOSTS_FILE=/ssh/known_hosts

# Timezone
TZ=America/Mexico_City
PROJECT_TIMEZONE=America/Mexico_City

# --- External API target (docker-compose.external-target.yml + make ext-*) ---
# Overlay del proyecto (fuera de este repo). Por defecto compose usa examples/demo-project.
# EXTERNAL_TARGET_NETWORK=perf-loadtest
# ORCHESTRATOR_PROJECT_DIR=../path/to/project-overlay
# TARGET_SSH_HOST=
# TARGET_SSH_USER=root
# TARGET_REMOTE_WORKDIR=/var/www
# PUBLIC_BASE_URL=
# TEST_BASE_URL=
# HEALTH_PATH=/api/health
# ACCESS_TOKEN_HEADER=X-Access-Token
# USER_TYPE_HEADER=
# AUTH_PROBE_PATH=/api/user/preferences
# PUBLIC_READ_PATHS=/api/events,/api/banners,/api/badge-price,/api/visitor-registration-paywall
# API_ACCESS_KEY=
# API_ADMIN_ACCESS_KEY=
# STUB_ACCESS_TOKEN=stub-token-loadtest
# STRIPE_PM_ID=pm_card_visa
# STRIPE_TEST_MODE_CONFIRMED=yes
# ENABLE_STRIPE_WEBHOOK=0
# VU_BASELINE=8
# VU_LOAD=10
# VU_STRESS=20
# VU_SPIKE=30
# VU_ENDURANCE=8
# BASELINE_DURATION=3m
# LOAD_DURATION=5m
# STRESS_DURATION=4m
# SPIKE_DURATION=2m
# ENDURANCE_DURATION=5m
#
# Hardware metrics (CPU/RAM peaks in HTML report). Requires: make ext-up
# MONITORING_ENABLED=true
# PROMETHEUS_URL=http://prometheus:9090
# PROM_CPU_QUERY=docker_container_cpu_cores{name=~".*figap_api_app.*"}
# PROM_MEMORY_QUERY=docker_container_memory_working_set_bytes{name=~".*figap_api_app.*"}
#
# DB snapshot around the run (mysqldump → restore; row deltas in report.html).
# Target must have mysql/mysqldump on PATH. Default false for local smoke.
# DB_SNAPSHOT_ENABLED=true
# Disable mysql client TLS on the target (Docker/private DB). Set false if the server requires SSL.
# DB_SNAPSHOT_DISABLE_SSL=true
# Optional free-form flags (non-empty overrides disable_ssl), e.g. --ssl-mode=REQUIRED
# DB_SNAPSHOT_MYSQL_OPTS=

# Host paths for hot data (avoids Docker.raw RO under load)
# ORCHESTRATOR_HOST_DATA=/Volumes/Ramon/docker-data/performance-orchestrator
